<!--
  Riverbend lab custom rules (SEV-1, SEV-2, SEV-3 precursors, mass-write support).
  Install: copy to /var/ossec/etc/rules/local_rules.xml
  then systemctl restart wazuh-manager.
-->
<group name="ransomware,windows,">

  <!-- Misses: direct-syscall dumpers and MiniDumpWriteDump from a trusted signed process; access masks outside 0x1010/0x1038/0x1fffff/0x143a -->
  <rule id="100100" level="14">
    <if_sid>61612</if_sid>
    <field name="win.eventdata.targetImage" type="pcre2">(?i)\\lsass\.exe$</field>
    <field name="win.eventdata.grantedAccess" type="pcre2">(?i)0x0*(1010|1038|1fffff|143a)(?![0-9a-f])</field>
    <description>LSASS memory access (T1003.001 OS Credential Dumping)</description>
    <mitre>
      <id>T1003.001</id>
    </mitre>
    <group>ransomware,sev1,</group>
  </rule>

  <!-- Misses: Get-WmiObject Win32_ShadowCopy | Remove-WmiObject and CIM equivalents until a later matcher; renamed vssadmin/wmic; diskshadow -->
  <rule id="100101" level="14">
    <if_sid>61603</if_sid>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)(?:vssadmin(?:\.exe)?"?\s+delete\s+shadows|wmic(?:\.exe)?"?\s+shadowcopy\s+delete|vssadmin(?:\.exe)?"?\s+resize\s+shadowstorage|bcdedit(?:\.exe)?"?\s+/set\s+\{default\}\s+recoveryenabled\s+no|wbadmin(?:\.exe)?"?\s+delete\s+catalog)</field>
    <description>Shadow copy deletion (T1490 Inhibit System Recovery)</description>
    <mitre>
      <id>T1490</id>
    </mitre>
    <group>ransomware,sev1,</group>
  </rule>

  <!-- Misses: encryption that keeps original filenames and extensions; ransom notes with custom names not in the listed set -->
  <rule id="100102" level="15">
    <if_sid>61613</if_sid>
    <field name="win.eventdata.targetFilename" type="pcre2">(?i)(RANSOM_NOTE\.txt|README_TO_DECRYPT|HOW_TO_RECOVER|DECRYPT_INSTRUCTIONS|\.(locked|encrypted|crypt|enc)$)</field>
    <description>Ransom note or encryption artifact written (T1486 Data Encrypted for Impact)</description>
    <mitre>
      <id>T1486</id>
    </mitre>
    <group>ransomware,sev1,</group>
  </rule>

  <!-- Misses: loopback IpAddress on purpose; IPC$-only traffic; 5145-only share access; admin-share use that never logs 5140 -->
  <rule id="100103" level="12">
    <if_sid>60100</if_sid>
    <field name="win.system.eventID" type="pcre2">^5140$</field>
    <field name="win.system.providerName" type="pcre2">Microsoft-Windows-Security-Auditing</field>
    <field name="win.eventdata.shareName" type="pcre2">(?i)\\\\[^\\]+\\(ADMIN|C)\$$</field>
    <field name="win.eventdata.ipAddress" type="pcre2">(?i)^(?!127\.)(?!::1$)(?!localhost$).+</field>
    <description>SMB admin-share lateral movement (T1021.002 Remote Services: SMB/Windows Admin Shares)</description>
    <mitre>
      <id>T1021.002</id>
    </mitre>
    <group>ransomware,sev2,</group>
  </rule>

  <!-- Misses: renamed PsExec service names; Impacket smbexec/wmiexec that never drop PSEXESVC; PAExec; CSExec -->
  <rule id="100104" level="12">
    <if_sid>60001</if_sid>
    <field name="win.system.eventID" type="pcre2">^7045$</field>
    <field name="win.system.providerName" type="pcre2">Service Control Manager</field>
    <field name="win.eventdata.imagePath" type="pcre2">(?i)(PSEXESVC(?:\.exe)?|\\\\[^\\]+\\ADMIN\$\\)</field>
    <description>PsExec-style remote service execution (T1569.002 System Services: Service Execution)</description>
    <mitre>
      <id>T1569.002</id>
    </mitre>
    <group>ransomware,sev2,</group>
  </rule>

  <!-- Misses: Run keys whose Details point at signed paths under Program Files; COM hijack; Winlogon; IFEO -->
  <rule id="100105" level="12">
    <if_sid>61615</if_sid>
    <field name="win.eventdata.targetObject" type="pcre2">(?i)\\CurrentVersion\\Run(Once)?\\</field>
    <field name="win.eventdata.details" type="pcre2">(?i)(\\Users\\|\\Temp\\|\\AppData\\|\\ProgramData\\|powershell|pwsh|wscript|cscript|mshta|cmd\.exe)</field>
    <description>Registry run-key persistence (T1547.001 Boot or Logon Autostart: Registry Run Keys)</description>
    <mitre>
      <id>T1547.001</id>
    </mitre>
    <group>ransomware,sev2,</group>
  </rule>

  <!-- Misses: Task Scheduler COM API or Register-ScheduledTask when the command line has no schtasks /create /sc; signed actions under Program Files -->
  <rule id="100106" level="12">
    <if_sid>60100,61603</if_sid>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)schtasks(?:\.exe)?\b.*\/create\b(?=.*\/sc\b)(?=.*(?:\\Users\\|powershell|pwsh|wscript|cscript|mshta|cmd\.exe))</field>
    <description>Scheduled task creation (T1053.005 Scheduled Task/Job: Scheduled Task)</description>
    <mitre>
      <id>T1053.005</id>
    </mitre>
    <group>ransomware,sev2,</group>
  </rule>

  <!-- Misses: new service whose ImagePath is a LOLBin under System32 without the listed strings; MSI install into Program Files; PSEXESVC is owned by 100104 -->
  <rule id="100107" level="12">
    <if_sid>60001</if_sid>
    <field name="win.system.eventID" type="pcre2">^7045$</field>
    <field name="win.system.providerName" type="pcre2">Service Control Manager</field>
    <field name="win.eventdata.imagePath" type="pcre2">(?i)(?!.*PSEXESVC)(\\Users\\|\\Temp\\|\\AppData\\|\\ProgramData\\|powershell|cmd\.exe\s+/c|rundll32|-enc)</field>
    <description>Suspicious new service (T1543.003 Create or Modify System Process: Windows Service)</description>
    <mitre>
      <id>T1543.003</id>
    </mitre>
    <group>ransomware,sev2,</group>
  </rule>

  <!-- Misses: Defender tamper via GPO, WMI, or a tamper-protection bypass that never sets the watched registry values or command-line flags; sc stop WinDefend and fltmc unload without the listed strings -->
  <rule id="100108" level="13">
    <if_sid>61603,61615</if_sid>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)(?:Set-MpPreference\s+-Disable\S*|Add-MpPreference\s+-ExclusionPath|auditpol(?:\.exe)?"?\s+/clear|Stop-Service\s+-Name\s+"?Sysmon\b|(?:\\Windows Defender\\DisableAntiSpyware|\\Real-Time Protection\\DisableRealtimeMonitoring))</field>
    <description>Defender or logging disabled (T1562.001 Impair Defenses)</description>
    <mitre>
      <id>T1562.001</id>
    </mitre>
    <group>ransomware,sev2,</group>
  </rule>

  <!-- Misses: .NET EventLog.Clear from a compiled binary; wevtutil with unusual quoting or a copied binary name; Security 1100 (event log service shutdown) -->
  <rule id="100109" level="13">
    <if_sid>60100,60001,61603</if_sid>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)(?:wevtutil(?:\.exe)?"?\s+cl\b|Clear-EventLog)</field>
    <description>Windows event log cleared (T1070.001 Indicator Removal: Clear Windows Event Logs)</description>
    <mitre>
      <id>T1070.001</id>
    </mitre>
    <group>ransomware,sev2,</group>
  </rule>

  <!-- Misses: token splitting, GZip+IEX, many Invoke-Obfuscation variants; script blocks that never land in 4104 with these markers -->
  <rule id="100110" level="10">
    <if_sid>61603</if_sid>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)(?:-EncodedCommand\b|-enc\b|-e\s+|FromBase64String|-w(?:indowstyle)?\s+hidden|-nop\s+-ep\s+bypass)</field>
    <description>Encoded or obfuscated PowerShell (T1059.001 Command and Scripting Interpreter: PowerShell)</description>
    <mitre>
      <id>T1059.001</id>
    </mitre>
    <group>ransomware,sev3,</group>
  </rule>

  <!-- Misses: Invoke-RestMethod; browser-driven downloads; certutil -decode of a local file; split-process transfers -->
  <rule id="100111" level="10">
    <if_sid>61603</if_sid>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)(?:Invoke-WebRequest|\biwr\s+|DownloadString|DownloadFile|Net\.WebClient|certutil(?:\.exe)?"?\s+-urlcache(?:\s+-split\s+-f)?|bitsadmin(?:\.exe)?"?\s+/transfer|curl(?:\.exe)?"?\s+-o\b|Start-BitsTransfer)</field>
    <description>Download cradle / ingress tool transfer (T1105 Ingress Tool Transfer)</description>
    <mitre>
      <id>T1105</id>
    </mitre>
    <group>ransomware,sev3,</group>
  </rule>

  <!-- Misses: writes outside Desktop/Documents/Downloads/Pictures under Users (AppData, Temp, ProgramData, network shares) -->
  <rule id="100120" level="3">
    <if_sid>61613</if_sid>
    <field name="win.eventdata.targetFilename" type="pcre2">(?i)\\Users\\[^\\]+\\(Desktop|Documents|Downloads|Pictures)\\</field>
    <description>File write to a user document path (support for mass-write burst)</description>
    <mitre>
      <id>T1486</id>
    </mitre>
    <group>ransomware,</group>
  </rule>

  <!-- Misses: encryption slower than 30 file creates per 60 seconds, or bursts whose paths never match 100120 -->
  <rule id="100121" level="15" frequency="30" timeframe="60">
    <if_matched_sid>100120</if_matched_sid>
    <same_field>win.system.computer</same_field>
    <field name="win.system.computer" type="pcre2">.+</field>
    <description>Mass file write burst (T1486 Data Encrypted for Impact)</description>
    <mitre>
      <id>T1486</id>
    </mitre>
    <group>ransomware,sev1,</group>
  </rule>

</group>
